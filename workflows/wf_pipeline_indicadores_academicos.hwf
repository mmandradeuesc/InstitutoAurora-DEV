<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_pipeline_indicadores_academicos</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orquestracao completa do pipeline Instituto Aurora.</description>
  <extended_description>Verifica entradas, ingere fontes, transforma, valida, carrega PostgreSQL e registra resultado.</extended_description>
  <workflow_version/><created_user>-</created_user><created_date>2026/09/13 00:00:00.000</created_date><modified_user>-</modified_user><modified_date>2026/09/13 00:00:00.000</modified_date>
  <parameters/>
  <actions>
    <action><name>Start</name><description/><type>SPECIAL</type><attributes/><repeat>N</repeat><schedulerType>0</schedulerType><intervalSeconds>0</intervalSeconds><intervalMinutes>60</intervalMinutes><hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth><parallel>N</parallel><xloc>64</xloc><yloc>160</yloc><attributes_hac/></action>
    <action><name>01_verificar_entradas</name><description/><type>FILES_EXIST</type><attributes/><fields><field><name>${PROJECT_HOME}/data/in/alunos.csv</name></field><field><name>${PROJECT_HOME}/data/in/cursos.csv</name></field><field><name>${PROJECT_HOME}/data/in/matriculas.csv</name></field></fields><parallel>N</parallel><xloc>240</xloc><yloc>160</yloc><attributes_hac/></action>
