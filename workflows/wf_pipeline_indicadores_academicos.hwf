    <action><name>03_ingestao_cursos</name><description/><type>PIPELINE</type><attributes/><filename>${PROJECT_HOME}/pipelines/ingestao/ingestao_cursos.hpl</filename><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><xloc>592</xloc><yloc>160</yloc><attributes_hac/></action>
    <action><name>04_ingestao_matriculas</name><description/><type>PIPELINE</type><attributes/><filename>${PROJECT_HOME}/pipelines/ingestao/ingestao_matriculas.hpl</filename><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><xloc>768</xloc><yloc>160</yloc><attributes_hac/></action>
